# Copiar este archivo a .env y completar valores reales. .env NO se versiona.

# Ruta base de datos (útil si los datos viven fuera del repo)
DATA_DIR=./data

# Token gratuito de la API DENUE (INEGI). Regístrate en:
# https://www.inegi.org.mx/servicios/api_denue.html
TOKEN_API_DENUE=

# API keys opcionales (ej. si se usa geocodificación externa: Google, Mapbox, HERE)
GEOCODING_API_KEY=

# Otros parámetros de entorno
ENVIRONMENT=development
